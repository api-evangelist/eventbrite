{
  "opencollection": "1.0.0",
  "info": {
    "name": "Eventbrite Platform Attendees Users API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.eventbriteapi.com/v3/users/me/"
          },
          "docs": "Returns the authenticated user. Confirmed by the Eventbrite Python SDK README: \"Not passing an argument returns yourself.\""
        }
      ]
    }
  ],
  "bundled": true
}